# Copia este archivo a `.env` junto al docker-compose.yml para cambiar algo. Todo es opcional.
#
# TREBEJOS_BIND=0.0.0.0        # 127.0.0.1 si el túnel corre en el mismo host (no en otro contenedor)
# TREBEJOS_PORT=3000           # puerto del host (dentro del contenedor siempre es 3000)
# BOT_ENABLED=true
# BOT_ENGINES=2
# RECONNECT_GRACE_SECONDS=90
# MIN_CLOCK_SECONDS=15
# MAX_ROOMS=500
# MAX_SPECTATORS_PER_ROOM=50
# ALLOW_PRIVATE_SPECTATORS=true
# WAITING_ROOM_TTL_MINUTES=30
# FINISHED_ROOM_TTL_MINUTES=15
# IDLE_ROOM_TTL_MINUTES=120
